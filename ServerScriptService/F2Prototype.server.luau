local Combat = require(script.Parent.F2Combat)
local Lives = require(script.Parent.F3Lives)
local Match = require(script.Parent.F4Match)
Combat.start(Lives)
Match.start()
local connection = game:GetService("RunService").PreSimulation:Connect(function(dt)
	Lives.step()
	Combat.step(dt)
end)
local matchConnection = game:GetService("RunService").Heartbeat:Connect(Match.step)
local function stop()
	connection:Disconnect()
	matchConnection:Disconnect()
	Match.stop()
	Lives.stop()
	Combat.stop()
end
script.Destroying:Connect(stop)
game:BindToClose(stop)
